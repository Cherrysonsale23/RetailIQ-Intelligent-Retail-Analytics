ENVIRONMENT=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# For legacy HS256 projects, configure SUPABASE_JWT_SECRET instead of the JWKS URL.
SUPABASE_JWT_SECRET=
MAX_UPLOAD_BYTES=8589934592
MAX_KAGGLE_IMPORT_BYTES=53687091200
KAGGLE_TEMP_DISK_FACTOR=1.5
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
